#!/bin/sh
# Installed as ~/.xinitrc — see deploy/README.md. No window manager: a kiosk
# showing exactly one always-fullscreen browser window doesn't need one. (The
# live kiosk uses XFCE + deploy/kiosk.sh instead, which the Browser tab needs:
# its window placement relies on a window manager.)

xset s off
xset -dpms
xset s noblank

exec chromium \
  --kiosk \
  --incognito \
  --noerrdialogs \
  --disable-infobars \
  --disable-translate \
  --no-first-run \
  --overscroll-history-navigation=0 \
  --disable-pinch \
  http://localhost:8000/
