[Unit]
Description=Add recipes sent from the PC via the NAS
# A template, like home-organizer-backup.service: deploy/README.md "Recipes from
# the PC" substitutes the real username for KIOSK_USER when installing it.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Root, because mounting the share needs it; the import itself drops to KIOSK_USER.
Environment=APP_USER=KIOSK_USER
Environment=BACKEND_DIR=/home/KIOSK_USER/home_organizer/backend
ExecStart=/bin/bash /home/KIOSK_USER/home_organizer/deploy/pull-recipes-from-nas.sh
# A NAS that doesn't answer shouldn't leave this running until the next one.
TimeoutStartSec=10min
