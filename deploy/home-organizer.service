[Unit]
Description=Home Organizer backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change both of these if you used a different username during imaging or a
# different clone location.
User=pi
WorkingDirectory=/home/pi/home_organizer/backend
# System directories stay on PATH: the Browser tab launches chromium and drives
# it with xdotool/wmctrl, all of which live in /usr/bin.
Environment=PATH=/home/pi/home_organizer/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin
# The X display the kiosk runs on — needed to open and place the browser window.
Environment=DISPLAY=:0
EnvironmentFile=-/home/pi/home_organizer/backend/.env
ExecStart=/home/pi/home_organizer/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Bound to 127.0.0.1, not 0.0.0.0 — see PLAN.md "Security & credentials".
# The kiosk browser runs on this same device, so there's no reason to expose
# the API to the rest of the LAN until the Android companion app is real.

[Install]
WantedBy=multi-user.target
