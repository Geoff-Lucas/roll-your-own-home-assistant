# Copy to .env and adjust for the target machine. All variables are optional;
# sensible defaults are used if unset (see app/config.py).

# Where the SQLite DB lives. Point this at the USB3 SSD mount, not the SD card.
# HOME_ORGANIZER_DATA_DIR=/mnt/ssd/home_organizer/data

# Where the Fernet encryption key for stored calendar credentials lives.
# Keep this outside the git repo and on the SSD, not the SD card.
# HOME_ORGANIZER_ENCRYPTION_KEY_PATH=/mnt/ssd/home_organizer/secret.key

# Origins allowed to call the API. Restrict once the frontend's dev/serve
# origin is known; "*" is fine for local-only development.
# HOME_ORGANIZER_CORS_ORIGINS=["http://localhost:5173"]

# Google Calendar linking (OAuth — see app/sync/google_oauth.py; Google's
# CalDAV requires this, basic auth no longer works). Create these at
# https://console.cloud.google.com/apis/credentials — OAuth client ID,
# type "Web application", with an authorized redirect URI matching
# HOME_ORGANIZER_GOOGLE_OAUTH_REDIRECT_URI below.
# HOME_ORGANIZER_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# HOME_ORGANIZER_GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
# HOME_ORGANIZER_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google-oauth/callback

# ALSA output device for timer chimes (and, later, spoken replies), used with
# `aplay -D`. "default" follows PulseAudio's default sink, which is a silent
# dummy sink on the kiosk — see deploy/README.md "Audio". On h-asst:
# HOME_ORGANIZER_AUDIO_DEVICE=plughw:0,3
# Local IANA timezone for alarms; blank uses the machine's own zone.
# HOME_ORGANIZER_TIMEZONE=America/New_York

# Voice assistant (see deploy/README.md "Voice assistant").
# ALSA capture device for the microphone, by card name; find it with `arecord -l`.
# HOME_ORGANIZER_MIC_DEVICE=plughw:CARD=Microphone,DEV=0
# Speech model (downloaded once with `python -m app.voice.setup`), and reply voice.
# HOME_ORGANIZER_VOICE_STT_MODEL=base.en
# HOME_ORGANIZER_VOICE_TTS=auto            # auto | piper | espeak | none
# Hands-free "Hey Jarvis" (holds the microphone open; see deploy/README.md).
# HOME_ORGANIZER_VOICE_WAKEWORD_ENABLED=true
# HOME_ORGANIZER_VOICE_WAKEWORD_THRESHOLD=0.5
# Reply voice with espeak-ng, e.g. a woman's voice, and its speed.
# HOME_ORGANIZER_VOICE_ESPEAK_VOICE=en-us+f3
# HOME_ORGANIZER_VOICE_ESPEAK_SPEED=160
# Say "stop" / "snooze" while a timer or alarm rings (no wake word). Listens for
# a few seconds after each chime; the microphone is only open while ringing.
# HOME_ORGANIZER_VOICE_RING_LISTEN=true
# HOME_ORGANIZER_VOICE_RING_WINDOW_SECONDS=3.0
